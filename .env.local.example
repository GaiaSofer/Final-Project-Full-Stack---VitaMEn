# Copy this file to .env.local and fill from your Supabase project:
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key is ONLY for seeding the catalog from your machine.
# Never commit it, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Gaigi needs no API key: the assistant is deterministic and answers only
# from the catalog and the static dosage reference table.
